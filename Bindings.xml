<Bindings>
	<!-- the step actions (Action.lua): use an item, cast a spell, or target an NPC/mob; once targeted, the same key
	     interacts (talk / attack). Action 1 is the step's main action, 2-4 its other targets and the side tasks.
	     category = the section name in Key Bindings. -->
	<Binding name="CLICK ObviGuideActionButton:LeftButton" category="Obvi Guide"/>
	<Binding name="CLICK ObviGuideActionButton2:LeftButton" category="Obvi Guide"/>
	<Binding name="CLICK ObviGuideActionButton3:LeftButton" category="Obvi Guide"/>
	<Binding name="CLICK ObviGuideActionButton4:LeftButton" category="Obvi Guide"/>
	<Binding name="OBVIGUIDE_NEXTSTEP" category="Obvi Guide">ObviGuide.NextStep()</Binding>
	<Binding name="OBVIGUIDE_PREVSTEP" category="Obvi Guide">ObviGuide.PrevStep()</Binding>
	<Binding name="OBVIGUIDE_TOGGLE" category="Obvi Guide">ObviGuide.Toggle()</Binding>
	<Binding name="OBVIGUIDE_PICKER" category="Obvi Guide">ObviGuide.Guides()</Binding>
</Bindings>
